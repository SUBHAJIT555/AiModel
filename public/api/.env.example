CREDIT_DATA_DIR=
# Token validity in days. Shown on the refund policy and used by the credit ledger.
CREDIT_VALIDITY_DAYS=90
# Optional. Extra minutes credits stay reserved after the UPI QR expires (default 20).
CREDIT_HOLD_GRACE_MINUTES=20
